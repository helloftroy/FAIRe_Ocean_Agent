# Copy to .env and fill in real values. Never commit .env.

# Database (SQLite by default; swap for PostgreSQL for multi-worker/server runs)
FAIR_OCEAN_DATABASE_URL=sqlite:///data/fair_ocean.db
# FAIR_OCEAN_DATABASE_URL=postgresql+psycopg2://localhost/fair_ocean
# FAIR_OCEAN_DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/fair_ocean

# Local or institutionally-hosted open-weight inference endpoint. "OpenAI-compatible"
# describes only the HTTP request/response shape (Ollama, vLLM, TGI, etc. all speak
# it) -- this never contacts OpenAI or requires an OpenAI account; LOCAL_LLM_BASE_URL
# is the only thing that determines where requests go. No model is chosen by
# default -- see config/benchmark_models.yaml to compare several candidates.
LOCAL_LLM_API_KEY=not-needed-for-ollama
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=REPLACE_WITH_MODEL_NAME

# Contact address used in the outbound User-Agent header for API/source requests
FAIR_OCEAN_CONTACT_EMAIL=REPLACE_WITH_CONTACT_EMAIL

# Optional API keys for structured sources that require them
NCBI_API_KEY=
CROSSREF_MAILTO=
